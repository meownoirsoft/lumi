# Free key from https://api.nasa.gov (DEMO_KEY works but is limited to ~30 requests/hour per IP).
NASA_API_KEY=DEMO_KEY
PORT=3000
# HOST=0.0.0.0
# DB_FILE=./data/window.db
# Kiosk (Raspberry Pi) screen mode: "auto" keeps the TV's choice (e.g. 4K).
# Other examples: 3840x2160@30Hz (lighter 4K), 1920x1080 (smoothest).
KIOSK_RESOLUTION=auto
# 1 = make YouTube send H.264 (smooth on a Pi, max 1080p video). 0 = allow VP9/AV1
# (needed for 4K YouTube video; only on hardware that can decode it).
KIOSK_H264=1
# How the screen schedule (admin page) turns the display off: both (default) =
# HDMI-CEC standby for TVs plus stopping the video signal; cec; dpms (signal
# only, for monitors); none (the player just shows black).
KIOSK_SCREEN_POWER=both
# DevTools port the kiosk browser opens on localhost, used to click inside web
# pages and to screenshot the TV for placing those clicks.
# KIOSK_DEBUG_PORT=9222
